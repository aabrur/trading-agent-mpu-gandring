{
  "name": "trading-agent-mpu-gandring",
  "version": "0.3.25",
  "appVersion": "0.0.0.3.25",
  "changelog": [
    "Implemented conversation continuity with persistent conversation sessions across reloads and backend restarts.",
    "Delivered traceable transaction history linking decisions, positions, orders, fills, closes, reviews, and evidence-based lessons.",
    "Integrated deterministic relevant experience retrieval considering agent role, symbol, account scope, and evaluation status.",
    "Added visible app version badge and conversation session controls in the desk UI."
  ],
  "description": "Trading Agent Mpu Gandring: a desk of AI trading agents that argue, debate and (cartoon) fight over every trade, then execute using Owner profile sizing and margin-based SL/TP. Paper by default; testnet or live after setup. Comes with a cozy virtual office UI.",
  "license": "MIT",
  "author": "Abrur Alaina",
  "type": "module",
  "bin": {
    "mpu": "bin/mpu.mjs"
  },
  "files": [
    "bin",
    "dist",
    "cli",
    "server",
    "web",
    "docs",
    ".env.example",
    "tsconfig.server.json",
    "tsconfig.web.json",
    "vite.config.ts"
  ],
  "private": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepack": "npm run build",
    "dev": "concurrently -k --kill-others-on-fail -n server,web -c yellow,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/server/index.js",
    "debate": "tsx cli/debate.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "screenshot": "node scripts/screenshot.mjs",
    "setup": "tsx cli/setup.ts",
    "doctor": "tsx cli/doctor.ts",
    "docs:setup": "tsx scripts/gen-setup-docs.ts",
    "gb": "tsx cli/gb.ts",
    "unkill": "tsx cli/unkill.ts",
    "channels": "tsx cli/channels.ts",
    "office": "concurrently -k --raw -n server,web \"npm:dev:server\" \"npm:dev:web\"",
    "office:status": "tsx cli/office-status.ts",
    "trade": "tsx cli/trade.ts",
    "autostart:install": "tsx cli/autostart.ts install",
    "autostart:remove": "tsx cli/autostart.ts remove",
    "autostart:status": "tsx cli/autostart.ts status",
    "bench:models": "tsx cli/bench-models.ts"
  },
  "keywords": [
    "trading",
    "ai-agents",
    "paper-trading",
    "multi-agent",
    "debate",
    "virtual-office",
    "crypto"
  ],
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@noble/curves": "^2.4.0",
    "@scure/base": "^2.4.0",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "lightweight-charts": "^5.2.1",
    "starknet": "^10.8.0",
    "viem": "^2.57.7",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}

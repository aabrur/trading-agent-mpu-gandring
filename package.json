{
  "name": "trading-agent-mpu-gandring",
  "version": "0.1.0",
  "description": "Trading Agent Mpu Gandring: a desk of AI trading agents that argue, debate and (cartoon) fight over every trade, then pass a risk gate before a paper fill. Comes with a virtual office UI.",
  "license": "MIT",
  "author": "Abrur Alaina",
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k --kill-others-on-fail -n server,web -c yellow,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/server/index.js",
    "debate": "tsx cli/debate.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "screenshot": "node scripts/screenshot.mjs"
  },
  "keywords": [
    "trading",
    "ai-agents",
    "paper-trading",
    "multi-agent",
    "debate",
    "virtual-office",
    "crypto"
  ],
  "dependencies": {
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "lightweight-charts": "^5.2.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}

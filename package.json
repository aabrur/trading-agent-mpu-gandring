{
  "name": "trading-agent-mpu-gandring",
  "version": "0.3.6",
  "appVersion": "0.0.0.3.6",
  "changelog": [
    "Removed the workspace headline/navigation and account summary sections.",
    "Agent roster uses one compact row with equal shapes, aligned text and consistent sizes.",
    "Office wall uses the project logo; the coffee corner has an espresso machine and the discussion table has coffee, a book and a plant.",
    "Open-order controls, allocation, equity and positions now share the map rail with PnL, fight meter and verdicts.",
    "Tool panels contain background scrolling while the pointer is inside; map PnL omits mode and source labels. Trading behavior is unchanged."
  ],
  "description": "Trading Agent Mpu Gandring: a desk of AI trading agents that argue, debate and (cartoon) fight over every trade, then pass a risk gate. Paper by default; full auto on testnet or live after a one-time setup, behind automatic guards. Comes with a cozy virtual office UI.",
  "license": "MIT",
  "author": "Abrur Alaina",
  "type": "module",
  "bin": { "mpu": "bin/mpu.mjs" },
  "files": ["bin", "dist", "cli", "server", "web", "docs", ".env.example", "tsconfig.server.json", "tsconfig.web.json", "vite.config.ts"],
  "private": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepack": "npm run build",
    "dev": "concurrently -k --kill-others-on-fail -n server,web -c yellow,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/server/index.js",
    "debate": "tsx cli/debate.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "screenshot": "node scripts/screenshot.mjs",
    "setup": "tsx cli/setup.ts",
    "doctor": "tsx cli/doctor.ts",
    "docs:setup": "tsx scripts/gen-setup-docs.ts",
    "gb": "tsx cli/gb.ts",
    "unkill": "tsx cli/unkill.ts",
    "channels": "tsx cli/channels.ts",
    "office": "concurrently -k --raw -n server,web \"npm:dev:server\" \"npm:dev:web\"",
    "office:status": "tsx cli/office-status.ts",
    "trade": "tsx cli/trade.ts",
    "autostart:install": "tsx cli/autostart.ts install",
    "autostart:remove": "tsx cli/autostart.ts remove",
    "autostart:status": "tsx cli/autostart.ts status"
  },
  "keywords": [
    "trading",
    "ai-agents",
    "paper-trading",
    "multi-agent",
    "debate",
    "virtual-office",
    "crypto"
  ],
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@noble/curves": "^2.4.0",
    "@scure/base": "^2.4.0",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "lightweight-charts": "^5.2.1",
    "starknet": "^10.8.0",
    "viem": "^2.57.7",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}

# Trading Agent Mpu Gandring configuration
# Copy to .env and edit. Never commit .env. Never paste keys in a chat.

# Easiest way to fill this file: npm run setup   (then npm run doctor)

# PAPER (default, simulated), TESTNET (exchange test funds) or LIVE (real money, full auto).
# TESTNET and LIVE need EXCHANGE and its keys. On every start the server checks the key on the
# exchange and refuses to start (exit code 2) if it can withdraw or cannot trade.
TRADING_MODE=PAPER

# Who drives the agents: local (models on this computer) or grokbot (your Grok Bot team, see docs/grokbot-mode.md)
APP_MODE=local
# Grok Bot mode only: shared secret for POST /api/agent-event. At least 24 characters. `npm run setup` generates one.
AGENT_EVENT_SECRET=

# Ports. The backend and the office bind 127.0.0.1 (this computer only) by default.
# HOST=0.0.0.0 opens them to your network or tailnet in PAPER/TESTNET. LIVE always binds 127.0.0.1.
PORT=8787
WEB_PORT=5173
# HOST=0.0.0.0

# ---------- Model API keys (server side only, all optional) ----------
# With no keys at all, every agent uses the built-in "mock" provider. It is offline,
# deterministic and its output is labeled EXAMPLE.
XAI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Optional base URL overrides (OpenAI-compatible endpoints).
XAI_BASE_URL=https://api.x.ai/v1
OPENAI_BASE_URL=https://api.openai.com/v1
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Default model per provider. These are placeholders. Model names change often,
# so check your provider's model list and edit them.
XAI_MODEL=grok-3-mini
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-haiku-latest
GEMINI_MODEL=gemini-2.0-flash
DEEPSEEK_MODEL=deepseek-chat
OPENROUTER_MODEL=openrouter/auto
# Optional app referer URL for OpenRouter attribution and dashboard icon crawling
OPENROUTER_HTTP_REFERER=https://aabrur.github.io/trading-agent-mpu-gandring/

# Which provider fallback to use when an agent has no mapping: mock | xai | openai | anthropic | gemini | deepseek | openrouter
DEFAULT_PROVIDER=mock

# ---------- Per-agent mapping (optional) ----------
# AGENT_<ID>_PROVIDER and AGENT_<ID>_MODEL. IDs: LEAD, MARKET, RESEARCH, STRATEGIST, RISK, EXECUTION (six agents)
# Example: let the agents fight with different brains.
# AGENT_LEAD_PROVIDER=xai
# AGENT_MARKET_PROVIDER=deepseek
# AGENT_RESEARCH_PROVIDER=gemini
# AGENT_STRATEGIST_PROVIDER=openai
# AGENT_RISK_PROVIDER=anthropic
# AGENT_RISK_MODEL=claude-3-5-haiku-latest
# AGENT_EXECUTION_PROVIDER=openrouter

# ---------- Market data (public, no key) ----------
# bybit | binance | hyperliquid | aster | dydx | paradex | orderly | sample.
# Falls back through the others, then to offline sample data.
MARKET_SOURCE=bybit
WATCHLIST=BTCUSDT,ETHUSDT,SOLUSDT
TICKER_REFRESH_SECONDS=20

# ---------- Money split (Boss's rule) ----------
# Money Trade = total balance - safety net. Allocation per order = Money Trade / N (1 to 4).
# The safety net is never traded. It must be above 0 in TESTNET and LIVE. In those modes the balance comes from the exchange.
PAPER_BALANCE=1000
SAFETY_NET=200
OPEN_ORDERS_N=4

# ---------- Owner profile: SL/TP are percentages of committed order margin ----------
MAX_LEVERAGE=5
DEFAULT_STOP_PCT=20
MIN_ENTRY_CONFIDENCE_PCT=60
MIN_ORDER_USDT=0
TAKER_FEE=0.00055
TAKE_PROFIT_PCT=60
# Daily loss stop: no new orders once equity is this many percent below the day's start (UTC day).
# Clamped to 0.5..25; the four profiles use 10 / 15 / 20 / 25.
DAILY_LOSS_LIMIT_PCT=10

# ---------- Debate ----------
DEBATE_ROUNDS=2
# Delay between speech chunks so the office looks alive. Use 0 for instant runs.
DEBATE_PACE_MS=700
# Fight starts when disagreement (0 to 1) is above this.
FIGHT_THRESHOLD=0.45

# ---------- Full auto ----------
# on = agents debate, open, close, set stops and take profits and size on their own. No approval step.
# `npm run setup` writes on by default. Unset here means off.
AUTO_TRADING=off
# Minutes between auto cycles (one debate per symbol per cycle).
DEBATE_INTERVAL_MIN=15
# Symbols the auto loop trades. Empty = WATCHLIST.
AUTO_SYMBOLS=
# Close any position held longer than this many hours. 0 = off.
MAX_HOLD_HOURS=0

# ---------- Learning (on by default) ----------
# proaktif-agent: scan before every auto cycle. self-improving: lessons after every cycle, loss,
# stop, error or owner correction; a lesson seen PROMOTE_AFTER times becomes a standing rule.
# Lessons are advice only and can never loosen a guard.
LEARNING=on
PROACTIVE_SCAN=on
REFLECT_EVERY_CYCLES=1
PROMOTE_AFTER=3
LOSS_WARN_PCT=70
STALE_FEED_MIN=10
# LEARNINGS_PATH=data/learnings.json

# ---------- Reports ----------
# Minutes between desk reports (written to reports/, shown in the office, sent to the Grok Bot bridge if set).
REPORT_INTERVAL_MIN=60

# ---------- Chat channels and the Desk Lead (optional; docs/channels.md) ----------
# Set up with: npm run channels -- setup <telegram|discord|slack|whatsapp>  (or the office Setup wizard, section 7).
# The Desk Lead sends alerts and reports to every channel set here. From chat, allowlisted ids can ONLY send:
# status, report, positions, kill. Orders, mode changes, un-kill and key changes are never possible from chat.
CHANNEL_COMMANDS=off
# SUPERVISOR=on
# SUPERVISOR_INTERVAL_MIN=5
# ALERT_COOLDOWN_MIN=30
# Separate inbound webhook server for Discord/Slack/WhatsApp commands (only /api/channels/*). Tunnel this port only.
# CHANNEL_WEBHOOK_PORT=8788
# CHANNEL_WEBHOOK_HOST=127.0.0.1
# Telegram (@BotFather). Commands use long polling: no public URL needed.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=
# Discord: channel webhook for posts; app public key for signed slash commands.
DISCORD_WEBHOOK_URL=
DISCORD_PUBLIC_KEY=
DISCORD_ALLOWED_USER_IDS=
# Slack: incoming webhook for posts; signing secret for the /desk slash command.
SLACK_WEBHOOK_URL=
SLACK_SIGNING_SECRET=
SLACK_ALLOWED_USER_IDS=
# WhatsApp: Meta WhatsApp Business Cloud API only (no unofficial WhatsApp Web libraries).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO=
# WHATSAPP_TEMPLATE_NAME=
# WHATSAPP_TEMPLATE_LANG=en_US
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ALLOWED_NUMBERS=
# WHATSAPP_GRAPH_VERSION=v26.0

# ---------- Grok Bot bridge (optional, off by default) ----------
# When both are set, the server POSTs verdict and command events to your Grok Bot webhook routine.
GROKBOT_WEBHOOK_URL=
GROKBOT_WEBHOOK_KEY=

# ---------- TradingView (optional) ----------
# on = show a TradingView chart widget next to the desk chart (loads tradingview.com in the browser).
TRADINGVIEW_WIDGET=off
TRADINGVIEW_EXCHANGE_PREFIX=BYBIT
# Set a passphrase (12+ chars) to accept alerts on POST /api/tradingview. Alerts only start a debate.
TRADINGVIEW_PASSPHRASE=

# ---------- Plugins (optional) ----------
# News: sample (built in) or cryptopanic (EXPERIMENTAL, needs a free or paid CryptoPanic API key).
NEWS_PROVIDER=sample
CRYPTOPANIC_API_KEY=
# CRYPTOPANIC_BASE_URL=https://cryptopanic.com/api/developer/v2/posts/

# High-alpha market data boosters (optional, all have zero-key public fallbacks)
COINGLASS_API_KEY=
TREE_OF_ALPHA_API_KEY=
ARKHAM_API_KEY=
FRED_API_KEY=
HYPERLIQUID_WHALE_ADDRESSES=

# ---------- Jev decision sidecar (optional, off by default) ----------
# Jev is TypeSafe's Decisions API model, reached through OpenRouter. It is not a seventh trading agent.
# The desk works with Jev disabled. Users bring their own OpenRouter key.
JEV_ENABLED=false
JEV_PROVIDER=openrouter
JEV_MODEL=typesafe/jev-1.14
JEV_MODE=shadow
# JEV_ENDPOINT=https://openrouter.ai/api/alpha/decisions
# Optional dedicated OpenRouter key for Jev. If empty, OPENROUTER_API_KEY is reused.
JEV_OPENROUTER_API_KEY=
# ASSIST may enrich PAPER, TESTNET, and LIVE analysis. LIVE assist requires an explicit Setup authorization (also stored as JEV_ALLOW_LIVE=yes).
JEV_ALLOW_LIVE=false
# Optional ASSIST wait budget in milliseconds. On timeout the desk continues without invented Jev results.
# JEV_ASSIST_BUDGET_MS=4000
# Decision engine: normal (full debate) or fast (skip redundant rebuttals when independent analysis agrees). Default normal.
# DEBATE_MODE=normal

# ---------- Exchange (optional, needed only for TESTNET and LIVE) ----------
# CEX: bybit | binance | okx.   DEX: hyperliquid | aster | dydx | paradex | orderly.   Or none.
# Bybit is fully implemented; all others are EXPERIMENTAL and untested on a real account. See docs/venues.md.
# DEX venues take a public address plus a DELEGATED trade-only key. Never a main wallet private key or seed phrase.
# Keys: trading permission ONLY. Withdrawals OFF. Setup and every start refuse any key that can withdraw.
EXCHANGE=none
BYBIT_TESTNET_API_KEY=
BYBIT_TESTNET_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Binance TESTNET = Binance Demo Trading (keys from demo.binance.com, API Key Management). Old testnet.binancefuture.com keys were retired.
# BINANCE_TESTNET_BASE_URL=https://demo-fapi.binance.com
OKX_TESTNET_API_KEY=
OKX_TESTNET_API_SECRET=
OKX_TESTNET_API_PASSPHRASE=
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
# Hyperliquid: the MAIN account address (public) plus the private key of an API AGENT wallet.
# Never the main wallet's private key. Setup and every start check that the agent is approved and is not the main key.
HYPERLIQUID_TESTNET_ACCOUNT_ADDRESS=
HYPERLIQUID_TESTNET_AGENT_PRIVATE_KEY=
HYPERLIQUID_ACCOUNT_ADDRESS=
HYPERLIQUID_AGENT_PRIVATE_KEY=
# Aster: the MAIN wallet address (public) plus the private key of a Pro API agent ("API wallet"), perp trading on,
# withdraw OFF. Refused unless Aster reports canWithdraw=false. Connect wallet in the office can create one for you.
ASTER_TESTNET_USER_ADDRESS=
ASTER_TESTNET_SIGNER_PRIVATE_KEY=
ASTER_USER_ADDRESS=
ASTER_SIGNER_PRIVATE_KEY=
# Optional, default off. Aster accounts report the ACCOUNT flag canWithdraw=true even when your agent cannot withdraw.
# Set this to YOUR agent's address (the address of ASTER_SIGNER_PRIVATE_KEY) to let the desk ask Aster for that agent's
# own flags (GET /fapi/v3/agent). Accepted only if Aster lists it for your main address with canWithdraw=false,
# canPerpTrade=true, not expired, and the account says canTrade=true. See docs/venues.md (Aster).
ASTER_AGENT_WITHDRAW_OFF_VERIFIED=
# ASTER_BASE_URL=https://fapi.asterdex.com
# ASTER_TESTNET_BASE_URL=https://fapi.asterdex-testnet.com
# dYdX v4: the owner dydx1... address (public), an API Trading Key private key, and its authenticator id (a number).
# The authenticator must allow only place/cancel order messages. Trading needs: npm install @dydxprotocol/v4-client-js
DYDX_TESTNET_ADDRESS=
DYDX_TESTNET_API_PRIVATE_KEY=
DYDX_TESTNET_AUTHENTICATOR_ID=
DYDX_ADDRESS=
DYDX_API_PRIVATE_KEY=
DYDX_AUTHENTICATOR_ID=
# DYDX_SUBACCOUNT=0
# DYDX_INDEXER_URL=https://indexer.dydx.trade/v4
# DYDX_VALIDATOR_URL=
# Paradex: the main Paradex account address (public) plus a registered SUBKEY private key (subkeys cannot withdraw).
PARADEX_TESTNET_ACCOUNT_ADDRESS=
PARADEX_TESTNET_SUBKEY_PRIVATE_KEY=
PARADEX_ACCOUNT_ADDRESS=
PARADEX_SUBKEY_PRIVATE_KEY=
# Orderly: the Orderly account id (public, 0x + 64 hex) plus an Orderly key secret (base58 ed25519), scope read,trading.
ORDERLY_TESTNET_ACCOUNT_ID=
ORDERLY_TESTNET_KEY_SECRET=
ORDERLY_ACCOUNT_ID=
ORDERLY_KEY_SECRET=
# Experimental adapters (everything except Bybit) need this before LIVE will start.
# ALLOW_EXPERIMENTAL_LIVE=no
# Startup reconcile: a venue position with no exchange-side stop gets one this many percent away (from the worse
# of entry and mark). If it cannot be placed, the position is closed.
# PROTECT_STOP_PCT=3

# Trading Agent Mpu Gandring configuration
# Copy to .env and edit. Never commit .env. Never paste keys in a chat.

# Safety switch. This version only knows PAPER. Anything else and the server exits with code 2.
TRADING_MODE=PAPER

# Ports. The backend binds 0.0.0.0 so other devices on your network or tailnet can open the office.
PORT=8787
WEB_PORT=5173

# ---------- Model API keys (server side only, all optional) ----------
# With no keys at all, every agent uses the built-in "mock" provider. It is offline,
# deterministic and its output is labeled EXAMPLE.
XAI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Optional base URL overrides (OpenAI-compatible endpoints).
XAI_BASE_URL=https://api.x.ai/v1
OPENAI_BASE_URL=https://api.openai.com/v1
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Default model per provider. These are placeholders. Model names change often,
# so check your provider's model list and edit them.
XAI_MODEL=grok-3-mini
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-haiku-latest
GEMINI_MODEL=gemini-2.0-flash
DEEPSEEK_MODEL=deepseek-chat
OPENROUTER_MODEL=openrouter/auto

# Which provider fallback to use when an agent has no mapping: mock | xai | openai | anthropic | gemini | deepseek | openrouter
DEFAULT_PROVIDER=mock

# ---------- Per-agent mapping (optional) ----------
# AGENT_<ID>_PROVIDER and AGENT_<ID>_MODEL. IDs: LEAD, MARKET, RESEARCH, STRATEGIST, RISK, EXECUTION, REVIEWER
# Example: let the agents fight with different brains.
# AGENT_LEAD_PROVIDER=xai
# AGENT_MARKET_PROVIDER=deepseek
# AGENT_RESEARCH_PROVIDER=gemini
# AGENT_STRATEGIST_PROVIDER=openai
# AGENT_RISK_PROVIDER=anthropic
# AGENT_RISK_MODEL=claude-3-5-haiku-latest
# AGENT_REVIEWER_PROVIDER=openrouter

# ---------- Market data (public, no key) ----------
# bybit | binance | hyperliquid | sample. Falls back down the list, then to offline sample data.
MARKET_SOURCE=bybit
WATCHLIST=BTCUSDT,ETHUSDT,SOLUSDT
TICKER_REFRESH_SECONDS=20

# ---------- Paper money split (Boss's rule) ----------
# Money Trade = total balance - safety net. Allocation per order = Money Trade / N.
PAPER_BALANCE=1000
SAFETY_NET=200
OPEN_ORDERS_N=4

# ---------- Risk caps (code enforced, agents can only tighten) ----------
MAX_LEVERAGE=3
DEFAULT_STOP_PCT=1.5
MIN_STOP_PCT=0.3
MAX_LOSS_PER_TRADE_PCT=1
MIN_ORDER_USDT=5
TAKER_FEE=0.00055
# Take profit at this many times the stop distance (0 = no take profit).
TAKE_PROFIT_R=2

# ---------- Debate ----------
DEBATE_ROUNDS=2
# Delay between speech chunks so the office looks alive. Use 0 for instant runs.
DEBATE_PACE_MS=700
# Fight starts when disagreement (0 to 1) is above this.
FIGHT_THRESHOLD=0.45
# Minutes between automatic debates on the watchlist. 0 = off (debates only on command).
AUTO_DEBATE_MINUTES=0

# ---------- Grok Bot bridge (optional, off by default) ----------
# When both are set, the server POSTs verdict and command events to your Grok Bot webhook routine.
GROKBOT_WEBHOOK_URL=
GROKBOT_WEBHOOK_KEY=
